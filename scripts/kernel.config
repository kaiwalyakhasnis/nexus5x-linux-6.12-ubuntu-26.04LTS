# CONFIG_ARCH_TEGRA_210_SOC is not set
# CONFIG_ARCH_TEGRA_186_SOC is not set
# CONFIG_ARCH_TEGRA_194_SOC is not set
# CONFIG_ARCH_TEGRA_234_SOC is not set
# CONFIG_ACPI is not set
# CONFIG_KVM is not set
# CONFIG_XEN is not set
# CONFIG_DRM_NOUVEAU is not set
# CONFIG_DRM_AMDGPU is not set
# CONFIG_DRM_RADEON is not set
# CONFIG_DEBUG_INFO_BTF is not set
# Hardware this board does not have (or mainline cannot drive yet)
# CONFIG_PCI is not set
# CONFIG_ATA is not set
# CONFIG_NVME_CORE is not set
# CONFIG_BLK_DEV_NVME is not set
# CONFIG_SOUND is not set
# CONFIG_ETHERNET is not set
# CONFIG_NFS_FS is not set
# CONFIG_EFI is not set
# CONFIG_MTD is not set
# CONFIG_WLAN is not set
# CONFIG_USB_XHCI_HCD is not set
# CONFIG_USB_EHCI_HCD is not set
# CONFIG_USB_OHCI_HCD is not set
# CONFIG_CAN is not set
# CONFIG_INFINIBAND is not set
# CONFIG_MEDIA_SUPPORT is not set
# A53/A57 cluster clocks for cpufreq-dt (kernel patch "clk: qcom: add MSM8992 CPU cluster clocks")
CONFIG_QCOM_CLK_CPU_8992=y
# Fused open-loop CPU voltages, starts cpufreq-dt (kernel patch "soc: qcom: add MSM8992 CPR open-loop voltages")
CONFIG_QCOM_CPR_8992=y
# Touchscreen: Synaptics S3320, RMI4 over I2C (F01 device control, F12 2D sensor)
CONFIG_RMI4_CORE=y
CONFIG_RMI4_I2C=y
CONFIG_RMI4_F11=y
CONFIG_RMI4_F12=y
CONFIG_RMI4_F55=y
# USB host for keyboards/mice: xHCI, the FUSB301 Type-C CC controller and the
# PMI8994 OTG boost (kernel patches "usb: misc: add FUSB301", "regulator: add
# PMI8994 OTG boost")
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PLATFORM=y
CONFIG_USB_FUSB301=y
CONFIG_REGULATOR_QCOM_PMI8994_OTG=y
