# Fragment merged on top of arm64 defconfig. Everything the phone needs must be
# built in, because the initramfs carries no modules.
CONFIG_LOCALVERSION="-bullhead-learn"
CONFIG_MSM_MMCC_8994=y
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
CONFIG_FONT_SUPPORT=y
CONFIG_FONTS=y
CONFIG_FONT_TER16x32=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
# qcom-pon populates the pwrkey (its reboot notifier sets the PS_HOLD reset
# type, else a reboot may power off) and provides the reboot modes
CONFIG_POWER_RESET_QCOM_PON=y
CONFIG_INPUT_PM8941_PWRKEY=y
CONFIG_INPUT_EVDEV=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# --- display: MDP5 + DSI + the JD35695B panel, WLED backlight (kernel patches)
# DRM_MSM may only be =y when these are =y or off: OCMEM is on the
# MSM8992 (GPU memory), LLCC is not.
CONFIG_QCOM_OCMEM=y
# CONFIG_QCOM_LLCC is not set
CONFIG_DRM_MSM=y
CONFIG_DRM_MSM_MDP5=y
CONFIG_DRM_MSM_DSI=y
CONFIG_DRM_MSM_DSI_20NM_PHY=y
CONFIG_DRM_PANEL_LG_BULLHEAD_JD35695B=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_QCOM_WLED=y
# CONFIG_DRM_MSM_DPU is not set
# CONFIG_DRM_MSM_MDP4 is not set
# CONFIG_DRM_MSM_DP is not set
# CONFIG_DRM_MSM_HDMI is not set
# CONFIG_DRM_MSM_DSI_28NM_PHY is not set
# CONFIG_DRM_MSM_DSI_28NM_8960_PHY is not set
# CONFIG_DRM_MSM_DSI_14NM_PHY is not set
# CONFIG_DRM_MSM_DSI_10NM_PHY is not set
# CONFIG_DRM_MSM_DSI_7NM_PHY is not set

# --- CPU: secondary A53 cores without PSCI (kernel patch)
CONFIG_ARM64_QCOM_8994_ACC=y

# --- size diet: LK's arm64 window is ~29 MB (0x80000..0x1e00000); drop other SoCs
