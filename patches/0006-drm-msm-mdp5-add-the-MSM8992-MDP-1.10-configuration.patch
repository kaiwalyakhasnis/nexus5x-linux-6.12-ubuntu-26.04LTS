From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: bullhead-linux <kaiwalyakhasnis57@gmail.com>
Date: Sat, 31 Oct 2026 06:55:25 +0900
Subject: [PATCH 06/12] drm/msm/mdp5: add the MSM8992 (MDP 1.10) configuration

Mainline knows MDP 1.9 (MSM8994) but not 1.10, the MSM8992's cut-down
version, so the display driver gives up with "unexpected MDP minor
revision". Pipes, mixers, CTLs, pingpongs and SMP blocks from the Nexus
5X's 3.10 msm8992-mdss.dtsi.
---
 drivers/gpu/drm/msm/disp/mdp5/mdp5_cfg.c | 101 +++++++++++++++++++++++
 1 file changed, 101 insertions(+)

diff --git a/drivers/gpu/drm/msm/disp/mdp5/mdp5_cfg.c b/drivers/gpu/drm/msm/disp/mdp5/mdp5_cfg.c
index df464f7c0..8470a05cb 100644
--- a/drivers/gpu/drm/msm/disp/mdp5/mdp5_cfg.c
+++ b/drivers/gpu/drm/msm/disp/mdp5/mdp5_cfg.c
@@ -623,6 +623,106 @@ static const struct mdp5_cfg_hw msm8x94_config = {
 	.max_clk = 400000000,
 };
 
+/*
+ * MSM8992 (Nexus 5X): MDP 1.10, a cut-down MSM8994 MDP. Blocks from the 3.10
+ * msm8992-mdss.dtsi, whose offsets count from the MDSS base, 0x1000 below
+ * the MDP base used here: 3 VIG, 3 RGB, 2 DMA pipes, 3 CTLs, 2 display layer
+ * mixers, 1 DSPP, 2 pingpongs, 34 SMP blocks.
+ */
+static const struct mdp5_cfg_hw msm8x92_config = {
+	.name = "msm8x92",
+	.mdp = {
+		.count = 1,
+		.caps = MDP_CAP_SMP |
+			MDP_CAP_SRC_SPLIT |
+			0,
+	},
+	.smp = {
+		.mmb_count = 34,
+		.mmb_size = 8192,
+		.clients = {
+			[SSPP_VIG0] =  1, [SSPP_VIG1] =  4,
+			[SSPP_VIG2] =  7,
+			[SSPP_DMA0] = 10, [SSPP_DMA1] = 13,
+			[SSPP_RGB0] = 16, [SSPP_RGB1] = 17,
+			[SSPP_RGB2] = 18,
+		},
+		/* qcom,mdss-pipe-{rgb,vig}-fixed-mmb: 3 x 5 + 3 x 1 */
+		.reserved_state[0] = GENMASK(17, 0),	/* first 18 MMBs */
+		.reserved = {
+			 [1] = 1,  [4] = 1,  [7] = 1,
+			[16] = 5, [17] = 5, [18] = 5,
+		},
+	},
+	.ctl = {
+		.count = 3,
+		.base = { 0x01000, 0x01200, 0x01400 },
+		.flush_hw_mask = 0xf0ffffff,
+	},
+	.pipe_vig = {
+		.count = 3,
+		.base = { 0x04000, 0x06000, 0x08000 },
+		.caps = MDP_PIPE_CAP_HFLIP | MDP_PIPE_CAP_VFLIP |
+				MDP_PIPE_CAP_SCALE | MDP_PIPE_CAP_CSC |
+				MDP_PIPE_CAP_DECIMATION,
+	},
+	.pipe_rgb = {
+		.count = 3,
+		.base = { 0x14000, 0x16000, 0x18000 },
+		.caps = MDP_PIPE_CAP_HFLIP | MDP_PIPE_CAP_VFLIP |
+				MDP_PIPE_CAP_SCALE | MDP_PIPE_CAP_DECIMATION,
+	},
+	.pipe_dma = {
+		.count = 2,
+		.base = { 0x24000, 0x26000 },
+		.caps = MDP_PIPE_CAP_HFLIP | MDP_PIPE_CAP_VFLIP,
+	},
+	.lm = {
+		.count = 2,
+		.base = { 0x44000, 0x45000 },
+		.instances = {
+				{ .id = 0, .pp = 0, .dspp = 0,
+				  .caps = MDP_LM_CAP_DISPLAY |
+					  MDP_LM_CAP_PAIR, },
+				{ .id = 1, .pp = 1, .dspp = -1,
+				  .caps = MDP_LM_CAP_DISPLAY |
+					  MDP_LM_CAP_PAIR, },
+			     },
+		/* 3.10: max_target_zorder 4, plus the base layer */
+		.nb_stages = 5,
+		.max_width = 2048,
+		.max_height = 0xFFFF,
+	},
+	.dspp = {
+		.count = 1,
+		.base = { 0x54000 },
+	},
+	.ad = {
+		.count = 1,
+		.base = { 0x78000 },
+	},
+	.pp = {
+		.count = 2,
+		.base = { 0x70000, 0x70800 },
+	},
+	.intf = {
+		.base = { 0x6a000, 0x6a800, 0x6b000, 0x6b800 },
+		.connect = {
+			[0] = INTF_DISABLED,
+			[1] = INTF_DSI,
+			[2] = INTF_DSI,
+			[3] = INTF_HDMI,
+		},
+	},
+	.perf = {
+		.ab_inefficiency = 100,
+		.ib_inefficiency = 100,
+		.clk_inefficiency = 105
+	},
+	/* 3.10 qcom,max-clk-rate */
+	.max_clk = 400000000,
+};
+
 static const struct mdp5_cfg_hw msm8x96_config = {
 	.name = "msm8x96",
 	.mdp = {
@@ -1409,6 +1509,7 @@ static const struct mdp5_cfg_handler cfg_handlers_v1[] = {
 	{ .revision = 6, .config = { .hw = &msm8x16_config } },
 	{ .revision = 8, .config = { .hw = &msm8x36_config } },
 	{ .revision = 9, .config = { .hw = &msm8x94_config } },
+	{ .revision = 10, .config = { .hw = &msm8x92_config } },
 	{ .revision = 7, .config = { .hw = &msm8x96_config } },
 	{ .revision = 11, .config = { .hw = &msm8x76_config } },
 	{ .revision = 14, .config = { .hw = &msm8937_config } },
