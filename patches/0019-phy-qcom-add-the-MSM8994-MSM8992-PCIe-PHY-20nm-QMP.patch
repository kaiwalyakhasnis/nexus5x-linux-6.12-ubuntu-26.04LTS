From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: bullhead-linux <kaiwalyakhasnis57@gmail.com>
Date: Sat, 31 Oct 2026 16:30:33 +0900
Subject: [PATCH 19/20] phy: qcom: add the MSM8994/MSM8992 PCIe PHY (20nm QMP)

From oneplus2-mainline (github.com/luvingiane/oneplus2-mainline, patch
0019, GPL-2.0): the first-generation QMP PCIe PHY of MSM8994, with the
init sequence, ready bit and power-down of the CAF kernel's pci-msm.c, and
the 125 MHz pipe clock GCC takes from it.

Added for MSM8992 (Nexus 5X): "qcom,vbg-opt", which the Nexus 5X 3.10 DT
sets on pcie0, selects the bandgap trims pcie_phy_init() writes with it
(IE_TRIM 0x03, IP_TRIM 0x00, BGTC 0xff) instead of IE_TRIM/IP_TRIM 0x0f.
---
 drivers/phy/qualcomm/Kconfig                 |   8 +
 drivers/phy/qualcomm/Makefile                |   1 +
 drivers/phy/qualcomm/phy-qcom-pcie-msm8994.c | 344 +++++++++++++++++++
 3 files changed, 353 insertions(+)
 create mode 100644 drivers/phy/qualcomm/phy-qcom-pcie-msm8994.c

diff --git a/drivers/phy/qualcomm/Kconfig b/drivers/phy/qualcomm/Kconfig
index 846f8c995..c17884e0b 100644
--- a/drivers/phy/qualcomm/Kconfig
+++ b/drivers/phy/qualcomm/Kconfig
@@ -42,6 +42,14 @@ config PHY_QCOM_IPQ806X_SATA
 	depends on OF
 	select GENERIC_PHY
 
+config PHY_QCOM_PCIE_MSM8994
+	tristate "Qualcomm MSM8994/MSM8992 PCIe PHY (20nm QMP)"
+	depends on OF && COMMON_CLK && (ARCH_QCOM || COMPILE_TEST)
+	select GENERIC_PHY
+	help
+	  The first-generation QMP PCIe PHY of MSM8994 and MSM8992 (the
+	  QCA6174 Wi-Fi bus on the OnePlus 2 and Nexus 5X).
+
 config PHY_QCOM_PCIE2
 	tristate "Qualcomm PCIe Gen2 PHY Driver"
 	depends on OF && COMMON_CLK && (ARCH_QCOM || COMPILE_TEST)
diff --git a/drivers/phy/qualcomm/Makefile b/drivers/phy/qualcomm/Makefile
index eb60e950a..193f019f9 100644
--- a/drivers/phy/qualcomm/Makefile
+++ b/drivers/phy/qualcomm/Makefile
@@ -6,6 +6,7 @@ obj-$(CONFIG_PHY_QCOM_IPQ4019_USB)	+= phy-qcom-ipq4019-usb.o
 obj-$(CONFIG_PHY_QCOM_IPQ806X_SATA)	+= phy-qcom-ipq806x-sata.o
 obj-$(CONFIG_PHY_QCOM_M31_USB)		+= phy-qcom-m31.o
 obj-$(CONFIG_PHY_QCOM_PCIE2)		+= phy-qcom-pcie2.o
+obj-$(CONFIG_PHY_QCOM_PCIE_MSM8994)	+= phy-qcom-pcie-msm8994.o
 
 obj-$(CONFIG_PHY_QCOM_QMP_COMBO)	+= phy-qcom-qmp-combo.o phy-qcom-qmp-usbc.o
 obj-$(CONFIG_PHY_QCOM_QMP_PCIE)		+= phy-qcom-qmp-pcie.o
diff --git a/drivers/phy/qualcomm/phy-qcom-pcie-msm8994.c b/drivers/phy/qualcomm/phy-qcom-pcie-msm8994.c
new file mode 100644
index 000000000..d9ce773de
--- /dev/null
+++ b/drivers/phy/qualcomm/phy-qcom-pcie-msm8994.c
@@ -0,0 +1,344 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Qualcomm MSM8994 PCIe PHY (20nm QMP, 19.2 MHz reference).
+ *
+ * From oneplus2-mainline (github.com/luvingiane/oneplus2-mainline, patch
+ * 0019, GPL-2.0): no mainline driver covers this first-generation QMP PCIe
+ * PHY. The init sequence is the one of the CAF kernel
+ * (drivers/pci/host/pci-msm.c: pcie_phy_init and pcie_phy_is_ready, the
+ * 20nm QMP branch); offsets are flat in the PHY region (QSERDES COM, TX, RX
+ * and PCS blocks).
+ *
+ * "qcom,vbg-opt" (set for the Nexus 5X, MSM8992, in its 3.10 DT) selects
+ * the bandgap trims pcie_phy_init() writes with it: IE_TRIM 0x03, IP_TRIM
+ * 0x00 and BGTC 0xff, instead of IE_TRIM/IP_TRIM 0x0f.
+ */
+
+#include <linux/clk.h>
+#include <linux/clk-provider.h>
+#include <linux/delay.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/phy/phy.h>
+#include <linux/platform_device.h>
+#include <linux/regulator/consumer.h>
+#include <linux/reset.h>
+
+#define PCIE_PHY_SW_RESET		0x600
+#define PCIE_PHY_POWER_DOWN_CONTROL	0x604
+#define PCIE_PHY_START			0x608
+#define PCIE_PHY_PCS_STATUS		0x728
+#define PCS_PHYSTATUS			BIT(6)
+
+struct msm8994_pcie_phy_init {
+	u16 reg;
+	u8 val;
+};
+
+#define QSERDES_COM_IE_TRIM		0x00c
+#define QSERDES_COM_IP_TRIM		0x010
+#define QSERDES_COM_BGTC		0x0a0
+
+/* pci-msm.c:973-988, in order: up to the bandgap trims */
+static const struct msm8994_pcie_phy_init msm8994_pcie_phy_tbl_head[] = {
+	{ 0x604, 0x03 },	/* PCIE_PHY_POWER_DOWN_CONTROL */
+	{ 0x048, 0x08 },	/* QSERDES_COM_SYSCLK_EN_SEL_TXBAND */
+	{ 0x0ac, 0x82 },	/* QSERDES_COM_DEC_START1 */
+	{ 0x10c, 0x03 },	/* QSERDES_COM_DEC_START2 */
+	{ 0x100, 0xd5 },	/* QSERDES_COM_DIV_FRAC_START1 */
+	{ 0x104, 0xaa },	/* QSERDES_COM_DIV_FRAC_START2 */
+	{ 0x108, 0x4d },	/* QSERDES_COM_DIV_FRAC_START3 */
+	{ 0x09c, 0x03 },	/* QSERDES_COM_PLLLOCK_CMP_EN */
+	{ 0x090, 0x06 },	/* QSERDES_COM_PLLLOCK_CMP1 */
+	{ 0x094, 0x1a },	/* QSERDES_COM_PLLLOCK_CMP2 */
+	{ 0x114, 0x7c },	/* QSERDES_COM_PLL_CRCTRL */
+	{ 0x034, 0x1f },	/* QSERDES_COM_PLL_CP_SETI */
+	{ 0x038, 0x12 },	/* QSERDES_COM_PLL_IP_SETP */
+	{ 0x03c, 0x0f },	/* QSERDES_COM_PLL_CP_SETP */
+	{ 0x024, 0x01 },	/* QSERDES_COM_PLL_IP_SETI */
+};
+
+/* pci-msm.c:997-1038: after the bandgap trims */
+static const struct msm8994_pcie_phy_init msm8994_pcie_phy_tbl_tail[] = {
+	{ 0x014, 0x46 },	/* QSERDES_COM_PLL_CNTRL */
+	{ 0x400, 0xf4 },	/* QSERDES_RX_CDR_CONTROL1 */
+	{ 0x408, 0x2c },	/* QSERDES_RX_CDR_CONTROL_HALF */
+	{ 0x004, 0xe1 },	/* QSERDES_COM_PLL_VCOTAIL_EN */
+	{ 0x04c, 0x91 },	/* QSERDES_COM_RESETSM_CNTRL */
+	{ 0x050, 0x07 },	/* QSERDES_COM_RESETSM_CNTRL2 */
+	{ 0x0e0, 0x20 },	/* QSERDES_COM_RES_CODE_START_SEG1 */
+	{ 0x0e8, 0x77 },	/* QSERDES_COM_RES_CODE_CAL_CSR */
+	{ 0x0f0, 0x15 },	/* QSERDES_COM_RES_TRIM_CONTROL */
+	{ 0x268, 0x03 },	/* QSERDES_TX_RCV_DETECT_LVL */
+	{ 0x414, 0x09 },	/* QSERDES_RX_UCDR_FO_GAIN */
+	{ 0x418, 0x04 },	/* QSERDES_RX_UCDR_SO_GAIN */
+	{ 0x41c, 0x49 },	/* QSERDES_RX_UCDR_SO_SATURATION_AND_ENABLE */
+	{ 0x4a8, 0xff },	/* QSERDES_RX_RX_EQ_GAIN1_LSB */
+	{ 0x4ac, 0x1f },	/* QSERDES_RX_RX_EQ_GAIN1_MSB */
+	{ 0x4b0, 0xff },	/* QSERDES_RX_RX_EQ_GAIN2_LSB */
+	{ 0x4b4, 0x00 },	/* QSERDES_RX_RX_EQ_GAIN2_MSB */
+	{ 0x4bc, 0x1e },	/* QSERDES_RX_RX_EQU_ADAPTOR_CNTRL2 */
+	{ 0x4f0, 0x67 },	/* QSERDES_RX_RX_EQ_OFFSET_ADAPTOR_CNTRL1 */
+	{ 0x4f4, 0x80 },	/* QSERDES_RX_RX_OFFSET_ADAPTOR_CNTRL2 */
+	{ 0x4f8, 0x40 },	/* QSERDES_RX_SIGDET_ENABLES */
+	{ 0x500, 0xb0 },	/* QSERDES_RX_SIGDET_CNTRL */
+	{ 0x504, 0x06 },	/* QSERDES_RX_SIGDET_DEGLITCH_CNTRL */
+	{ 0x110, 0x10 },	/* QSERDES_COM_PLL_RXTXEPCLK_EN */
+	{ 0x648, 0x10 },	/* PCIE_PHY_ENDPOINT_REFCLK_DRIVE */
+	{ 0x650, 0xa3 },	/* PCIE_PHY_POWER_STATE_CONFIG1 */
+	{ 0x654, 0x4b },	/* PCIE_PHY_POWER_STATE_CONFIG2 */
+	{ 0x64c, 0x4d },	/* PCIE_PHY_RX_IDLE_DTCT_CNTRL */
+	{ 0x600, 0x00 },	/* PCIE_PHY_SW_RESET */
+	{ 0x608, 0x03 },	/* PCIE_PHY_START */
+};
+
+struct msm8994_pcie_phy {
+	struct device *dev;
+	void __iomem *base;
+	struct clk *ref_clk;
+	struct clk *ldo_clk;
+	struct clk *pipe_clk;
+	struct regulator_bulk_data vregs[2];
+	struct reset_control *reset;
+	struct reset_control *pipe_reset;	/* optional */
+	bool vbg_opt;
+};
+
+static void msm8994_pcie_phy_write(struct msm8994_pcie_phy *qphy,
+				   const struct msm8994_pcie_phy_init *tbl,
+				   unsigned int n)
+{
+	unsigned int i;
+
+	for (i = 0; i < n; i++)
+		writel(tbl[i].val, qphy->base + tbl[i].reg);
+}
+
+static int msm8994_pcie_phy_init(struct phy *phy)
+{
+	struct msm8994_pcie_phy *qphy = phy_get_drvdata(phy);
+	int ret;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(qphy->vregs), qphy->vregs);
+	if (ret)
+		return ret;
+
+	ret = clk_prepare_enable(qphy->ref_clk);
+	if (ret)
+		goto err_vregs;
+	ret = clk_prepare_enable(qphy->ldo_clk);
+	if (ret)
+		goto err_ref;
+
+	ret = reset_control_assert(qphy->reset);
+	if (ret)
+		goto err_ldo;
+	usleep_range(100, 150);
+	ret = reset_control_deassert(qphy->reset);
+	if (ret)
+		goto err_ldo;
+
+	return 0;
+
+err_ldo:
+	clk_disable_unprepare(qphy->ldo_clk);
+err_ref:
+	clk_disable_unprepare(qphy->ref_clk);
+err_vregs:
+	regulator_bulk_disable(ARRAY_SIZE(qphy->vregs), qphy->vregs);
+	return ret;
+}
+
+static int msm8994_pcie_phy_power_on(struct phy *phy)
+{
+	struct msm8994_pcie_phy *qphy = phy_get_drvdata(phy);
+	u32 val;
+	int ret;
+
+	msm8994_pcie_phy_write(qphy, msm8994_pcie_phy_tbl_head,
+			       ARRAY_SIZE(msm8994_pcie_phy_tbl_head));
+	if (qphy->vbg_opt) {
+		writel(0x03, qphy->base + QSERDES_COM_IE_TRIM);
+		writel(0x00, qphy->base + QSERDES_COM_IP_TRIM);
+		writel(0xff, qphy->base + QSERDES_COM_BGTC);
+	} else {
+		writel(0x0f, qphy->base + QSERDES_COM_IE_TRIM);
+		writel(0x0f, qphy->base + QSERDES_COM_IP_TRIM);
+	}
+	msm8994_pcie_phy_write(qphy, msm8994_pcie_phy_tbl_tail,
+			       ARRAY_SIZE(msm8994_pcie_phy_tbl_tail));
+
+	/*
+	 * CAF: PHY stabilisation, then the pipe clock at 125 MHz (that
+	 * selects the PHY's own pipe output in GCC, patch 0021), then wait
+	 */
+	usleep_range(1000, 1100);
+	/*
+	 * CAF (msm_pcie_pipe_clk_init) takes the PHY's pipe side out of
+	 * reset (GCC PCIE_PHY_0_PHY_BCR) right before the pipe clock; the
+	 * boot leaves it asserted, and then the PLL never starts.
+	 */
+	ret = reset_control_deassert(qphy->pipe_reset);
+	if (ret)
+		return ret;
+	ret = clk_set_rate(qphy->pipe_clk, 125000000);
+	if (ret)
+		dev_warn(qphy->dev, "pipe clock rate: %d\n", ret);
+	ret = clk_prepare_enable(qphy->pipe_clk);
+	if (ret)
+		return ret;
+
+	ret = readl_poll_timeout(qphy->base + PCIE_PHY_PCS_STATUS, val,
+				 !(val & PCS_PHYSTATUS), 1000, 1000000);
+	if (ret) {
+		/* bring-up: what state the PLL / reset machine reached */
+		dev_err(qphy->dev,
+			"PHY not ready: PCS_STATUS %#x PCS_STATUS2 %#x RESET_SM %#x PLL_VCO_HIGH %#x CORE_VCO_TUNE %#x START %#x PWRDN %#x\n",
+			val, readl(qphy->base + 0x72c), readl(qphy->base + 0x150),
+			readl(qphy->base + 0x14c), readl(qphy->base + 0x160),
+			readl(qphy->base + PCIE_PHY_START),
+			readl(qphy->base + PCIE_PHY_POWER_DOWN_CONTROL));
+		dev_err(qphy->dev,
+			"readback: SYSCLK_EN_SEL %#x (08) DEC_START1 %#x (82) PLL_CNTRL %#x (46) CDR1 %#x (f4) RX_EQ_GAIN1_MSB %#x (1f) PWR_STATE_CFG1 %#x (a3)\n",
+			readl(qphy->base + 0x048), readl(qphy->base + 0x0ac),
+			readl(qphy->base + 0x014), readl(qphy->base + 0x400),
+			readl(qphy->base + 0x4ac), readl(qphy->base + 0x650));
+		clk_disable_unprepare(qphy->pipe_clk);
+		return ret;
+	}
+	dev_info(qphy->dev, "PHY ready%s\n", qphy->vbg_opt ? " (vbg-opt)" : "");
+	return 0;
+}
+
+static int msm8994_pcie_phy_power_off(struct phy *phy)
+{
+	struct msm8994_pcie_phy *qphy = phy_get_drvdata(phy);
+
+	writel(0x1, qphy->base + PCIE_PHY_SW_RESET);
+	writel(0x0, qphy->base + PCIE_PHY_POWER_DOWN_CONTROL);
+	clk_disable_unprepare(qphy->pipe_clk);
+	return 0;
+}
+
+static int msm8994_pcie_phy_exit(struct phy *phy)
+{
+	struct msm8994_pcie_phy *qphy = phy_get_drvdata(phy);
+
+	reset_control_assert(qphy->pipe_reset);
+	reset_control_assert(qphy->reset);
+	clk_disable_unprepare(qphy->ldo_clk);
+	clk_disable_unprepare(qphy->ref_clk);
+	regulator_bulk_disable(ARRAY_SIZE(qphy->vregs), qphy->vregs);
+	return 0;
+}
+
+static const struct phy_ops msm8994_pcie_phy_ops = {
+	.init		= msm8994_pcie_phy_init,
+	.power_on	= msm8994_pcie_phy_power_on,
+	.power_off	= msm8994_pcie_phy_power_off,
+	.exit		= msm8994_pcie_phy_exit,
+	.owner		= THIS_MODULE,
+};
+
+/* the 125 MHz pipe clock this PHY feeds to GCC ("pcie_0_pipe") */
+static int msm8994_pcie_phy_pipe_clk_register(struct msm8994_pcie_phy *qphy)
+{
+	struct device_node *np = qphy->dev->of_node;
+	struct clk_init_data init = { };
+	struct clk_fixed_rate *fixed;
+	int ret;
+
+	if (of_property_read_string(np, "clock-output-names", &init.name))
+		init.name = "pcie_0_pipe_clk";
+
+	fixed = devm_kzalloc(qphy->dev, sizeof(*fixed), GFP_KERNEL);
+	if (!fixed)
+		return -ENOMEM;
+
+	init.ops = &clk_fixed_rate_ops;
+	fixed->fixed_rate = 125000000;
+	fixed->hw.init = &init;
+
+	ret = devm_clk_hw_register(qphy->dev, &fixed->hw);
+	if (ret)
+		return ret;
+
+	return devm_of_clk_add_hw_provider(qphy->dev, of_clk_hw_simple_get,
+					   &fixed->hw);
+}
+
+static int msm8994_pcie_phy_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct phy_provider *provider;
+	struct msm8994_pcie_phy *qphy;
+	struct phy *phy;
+	int ret;
+
+	qphy = devm_kzalloc(dev, sizeof(*qphy), GFP_KERNEL);
+	if (!qphy)
+		return -ENOMEM;
+	qphy->dev = dev;
+
+	qphy->base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(qphy->base))
+		return PTR_ERR(qphy->base);
+
+	/* before getting our own clocks: GCC's pipe clock has this as parent */
+	ret = msm8994_pcie_phy_pipe_clk_register(qphy);
+	if (ret)
+		return ret;
+
+	qphy->vbg_opt = of_property_read_bool(dev->of_node, "qcom,vbg-opt");
+
+	qphy->ref_clk = devm_clk_get(dev, "ref");
+	if (IS_ERR(qphy->ref_clk))
+		return dev_err_probe(dev, PTR_ERR(qphy->ref_clk), "ref clock\n");
+	qphy->ldo_clk = devm_clk_get(dev, "ldo");
+	if (IS_ERR(qphy->ldo_clk))
+		return dev_err_probe(dev, PTR_ERR(qphy->ldo_clk), "ldo clock\n");
+	qphy->pipe_clk = devm_clk_get(dev, "pipe");
+	if (IS_ERR(qphy->pipe_clk))
+		return dev_err_probe(dev, PTR_ERR(qphy->pipe_clk), "pipe clock\n");
+
+	qphy->vregs[0].supply = "vdda-phy";
+	qphy->vregs[1].supply = "vdda-pll";
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(qphy->vregs), qphy->vregs);
+	if (ret)
+		return ret;
+
+	qphy->reset = devm_reset_control_get_exclusive(dev, "phy");
+	if (IS_ERR(qphy->reset))
+		return dev_err_probe(dev, PTR_ERR(qphy->reset), "phy reset\n");
+	qphy->pipe_reset = devm_reset_control_get_optional_exclusive(dev, "pipe");
+	if (IS_ERR(qphy->pipe_reset))
+		return dev_err_probe(dev, PTR_ERR(qphy->pipe_reset), "pipe reset\n");
+
+	phy = devm_phy_create(dev, dev->of_node, &msm8994_pcie_phy_ops);
+	if (IS_ERR(phy))
+		return PTR_ERR(phy);
+	phy_set_drvdata(phy, qphy);
+
+	provider = devm_of_phy_provider_register(dev, of_phy_simple_xlate);
+	return PTR_ERR_OR_ZERO(provider);
+}
+
+static const struct of_device_id msm8994_pcie_phy_of_match[] = {
+	{ .compatible = "qcom,msm8994-pcie-phy" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, msm8994_pcie_phy_of_match);
+
+static struct platform_driver msm8994_pcie_phy_driver = {
+	.probe = msm8994_pcie_phy_probe,
+	.driver = {
+		.name = "qcom-msm8994-pcie-phy",
+		.of_match_table = msm8994_pcie_phy_of_match,
+	},
+};
+module_platform_driver(msm8994_pcie_phy_driver);
+
+MODULE_DESCRIPTION("Qualcomm MSM8994 PCIe PHY (20nm QMP)");
+MODULE_LICENSE("GPL");
