From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: bullhead-linux <kaiwalyakhasnis57@gmail.com>
Date: Sat, 31 Oct 2026 06:58:04 +0900
Subject: [PATCH 7/7] drm/panel: add the LG Nexus 5X JD35695B command-mode
 panel

Supplies, DSV enables, reset sequence, gamma tables and init commands from
the phone's 3.10 kernel (msm8992-bullhead-panel.dtsi,
dsi-panel-jd35695b-1080p-cmd.dtsi, mdss_dsi_panel.c, dw8768-regulator.c).
LK names its gamma table on the command line; the same one is used.
---
 drivers/gpu/drm/panel/Kconfig                 |   9 +
 drivers/gpu/drm/panel/Makefile                |   1 +
 .../panel/panel-lg-bullhead-jd35695b-gamma.h  | 200 ++++++++++
 .../drm/panel/panel-lg-bullhead-jd35695b.c    | 349 ++++++++++++++++++
 4 files changed, 559 insertions(+)
 create mode 100644 drivers/gpu/drm/panel/panel-lg-bullhead-jd35695b-gamma.h
 create mode 100644 drivers/gpu/drm/panel/panel-lg-bullhead-jd35695b.c

diff --git a/drivers/gpu/drm/panel/Kconfig b/drivers/gpu/drm/panel/Kconfig
index a8cf1b0a5..605945404 100644
--- a/drivers/gpu/drm/panel/Kconfig
+++ b/drivers/gpu/drm/panel/Kconfig
@@ -359,6 +359,15 @@ config DRM_PANEL_LINCOLNTECH_LCD197
 	  24 bit RGB per pixel. It provides a MIPI DSI interface to
 	  the host.
 
+config DRM_PANEL_LG_BULLHEAD_JD35695B
+	tristate "LG Nexus 5X JD35695B DSI command mode panel"
+	depends on OF
+	depends on DRM_MIPI_DSI
+	depends on BACKLIGHT_CLASS_DEVICE
+	help
+	  Say Y here if you want to enable support for the 1080x1920
+	  command-mode panel of the LG Nexus 5X (bullhead).
+
 config DRM_PANEL_LG_LB035Q02
 	tristate "LG LB035Q024573 RGB panel"
 	depends on GPIOLIB && OF && SPI
diff --git a/drivers/gpu/drm/panel/Makefile b/drivers/gpu/drm/panel/Makefile
index 987a08702..78223a05d 100644
--- a/drivers/gpu/drm/panel/Makefile
+++ b/drivers/gpu/drm/panel/Makefile
@@ -36,6 +36,7 @@ obj-$(CONFIG_DRM_PANEL_KINGDISPLAY_KD097D04) += panel-kingdisplay-kd097d04.o
 obj-$(CONFIG_DRM_PANEL_LEADTEK_LTK050H3146W) += panel-leadtek-ltk050h3146w.o
 obj-$(CONFIG_DRM_PANEL_LEADTEK_LTK500HD1829) += panel-leadtek-ltk500hd1829.o
 obj-$(CONFIG_DRM_PANEL_LINCOLNTECH_LCD197) += panel-lincolntech-lcd197.o
+obj-$(CONFIG_DRM_PANEL_LG_BULLHEAD_JD35695B) += panel-lg-bullhead-jd35695b.o
 obj-$(CONFIG_DRM_PANEL_LG_LB035Q02) += panel-lg-lb035q02.o
 obj-$(CONFIG_DRM_PANEL_LG_LG4573) += panel-lg-lg4573.o
 obj-$(CONFIG_DRM_PANEL_LG_SW43408) += panel-lg-sw43408.o
