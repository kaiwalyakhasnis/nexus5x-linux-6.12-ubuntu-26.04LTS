--- /dev/null
+++ b/drivers/gpu/drm/panel/panel-lg-bullhead-jd35695b.c
@@ -0,0 +1,349 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * JD35695B 1080x1920 command-mode DSI panel of the LG Nexus 5X (bullhead).
+ *
+ * Everything here comes from the phone's 3.10 kernel:
+ *   arch/arm64/boot/dts/lge/msm8992-bullhead-panel.dtsi (supplies, GPIOs),
+ *   arch/arm64/boot/dts/lge/dsi-panel-jd35695b-1080p-cmd.dtsi (timings,
+ *   commands, gamma), drivers/video/msm/mdss/mdss_dsi_panel.c (order:
+ *   supplies, DSV, reset sequence, gamma, on-commands) and
+ *   drivers/regulator/dw8768-regulator.c (the +-5.5 V DSV: two enables).
+ * The structure follows panel-oneplus2-jd35695.c of oneplus2-mainline
+ * (github.com/luvingiane/oneplus2-mainline, GPL-2.0), the same panel family
+ * on the MSM8994.
+ *
+ * LK picks one of three gamma tables per panel and names it on the kernel
+ * command line ("...jd35695b_1080p_cmd_type10..."); the same one is used here.
+ */
+
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/mod_devicetable.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/regulator/consumer.h>
+
+#include <video/mipi_display.h>
+
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_panel.h>
+#include <drm/drm_probe_helper.h>
+
+#include "panel-lg-bullhead-jd35695b-gamma.h"
+
+static const struct {
+	const char *cmdline;	/* as LK names the panel node */
+	const u8 (*table)[2];
+	unsigned int len;
+} jd35695b_gammas[] = {
+	{ "jd35695b_1080p_cmd_type00", jd35695b_gamma_type00, ARRAY_SIZE(jd35695b_gamma_type00) },
+	{ "jd35695b_1080p_cmd_type10", jd35695b_gamma_type10, ARRAY_SIZE(jd35695b_gamma_type10) },
+	{ "jd35695b_1080p_cmd", jd35695b_gamma_default, ARRAY_SIZE(jd35695b_gamma_default) },
+};
+
+/* bring-up: keep the panel as LK left it (no power cycle, no gamma) */
+static bool keep;
+module_param(keep, bool, 0444);
+MODULE_PARM_DESC(keep, "Keep LK's panel state on the first power-up");
+
+struct jd35695b {
+	struct drm_panel panel;
+	struct mipi_dsi_device *dsi;
+	struct regulator_bulk_data supplies[2];
+	struct gpio_desc *reset_gpio;
+	/* DW8768 DSV: positive (ena, GPIO 89) and negative (enm, GPIO 90) rail */
+	struct gpio_desc *dsv_pos_gpio, *dsv_neg_gpio;
+	const u8 (*gamma)[2];
+	unsigned int gamma_len;
+	bool lk_on;	/* LK left the panel on and nothing has touched it yet */
+};
+
+static inline struct jd35695b *to_jd35695b(struct drm_panel *panel)
+{
+	return container_of(panel, struct jd35695b, panel);
+}
+
+/* dw8768_regulator_enable(): ena, enm, 3.7 ms (dw,post-on-sleep-us) */
+static void jd35695b_dsv_on(struct jd35695b *ctx)
+{
+	gpiod_set_value_cansleep(ctx->dsv_pos_gpio, 1);
+	gpiod_set_value_cansleep(ctx->dsv_neg_gpio, 1);
+	usleep_range(3700, 4000);
+}
+
+/* dw8768_regulator_disable(): enm, ena, 6 ms (dw,post-off-sleep-us) */
+static void jd35695b_dsv_off(struct jd35695b *ctx)
+{
+	gpiod_set_value_cansleep(ctx->dsv_neg_gpio, 0);
+	gpiod_set_value_cansleep(ctx->dsv_pos_gpio, 0);
+	usleep_range(6000, 7000);
+}
+
+/* qcom,mdss-dsi-reset-sequence = <0 10>, <1 10>, <0 1>, <1 0> (line levels) */
+static void jd35695b_reset(struct jd35695b *ctx)
+{
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	usleep_range(10000, 11000);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	usleep_range(10000, 11000);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	usleep_range(1000, 2000);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	/* qcom,mdss-dsi-init-delay-us */
+	usleep_range(20000, 21000);
+}
+
+/* qcom,mdss-dsi-on-command, sent in LP mode */
+static void jd35695b_on_cmds(struct mipi_dsi_multi_context *dsi_ctx)
+{
+	mipi_dsi_dcs_set_tear_on_multi(dsi_ctx, MIPI_DSI_DCS_TEAR_MODE_VBLANK);
+	mipi_dsi_dcs_set_tear_scanline_multi(dsi_ctx, 0x0778);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xc9, 0x49, 0x02, 0x05, 0x00, 0x0f,
+				     0x06, 0x67, 0x03, 0x2e, 0x10, 0xf0);
+	mipi_dsi_dcs_set_column_address_multi(dsi_ctx, 0x0000, 0x0437);
+	mipi_dsi_dcs_set_page_address_multi(dsi_ctx, 0x0000, 0x077f);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0xfb, 0x01);
+}
+
+static int jd35695b_on(struct jd35695b *ctx)
+{
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+	unsigned int i;
+
+	ctx->dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	for (i = 0; i < ctx->gamma_len; i++)
+		mipi_dsi_generic_write_multi(&dsi_ctx, ctx->gamma[i], 2);
+
+	jd35695b_on_cmds(&dsi_ctx);
+	mipi_dsi_dcs_exit_sleep_mode_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 101);
+	mipi_dsi_dcs_set_display_on_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 41);
+
+	return dsi_ctx.accum_err;
+}
+
+/* qcom,mdss-dsi-off-command, sent in HS mode */
+static int jd35695b_off(struct jd35695b *ctx)
+{
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	ctx->dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+
+	mipi_dsi_dcs_set_display_off_multi(&dsi_ctx);
+	mipi_dsi_dcs_enter_sleep_mode_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 61);
+
+	return dsi_ctx.accum_err;
+}
+
+static int jd35695b_prepare(struct drm_panel *panel)
+{
+	struct jd35695b *ctx = to_jd35695b(panel);
+	struct device *dev = &ctx->dsi->dev;
+	int ret;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(ctx->supplies), ctx->supplies);
+	if (ret < 0) {
+		dev_err(dev, "Failed to enable regulators: %d\n", ret);
+		return ret;
+	}
+
+	if (ctx->lk_on && keep) {
+		struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+		dev_info(dev, "keeping LK's panel state\n");
+		ctx->lk_on = false;
+		ctx->dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+		jd35695b_on_cmds(&dsi_ctx);
+		return dsi_ctx.accum_err;
+	}
+
+	if (ctx->lk_on) {
+		/* take LK's panel down first: a reset under live bias leaves it dark */
+		jd35695b_off(ctx);
+		jd35695b_dsv_off(ctx);
+		gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+		msleep(100);
+		ctx->lk_on = false;
+	}
+
+	/* mdss_dsi_panel_reset(1) with qcom,dsv-pre-on: DSV, then reset */
+	jd35695b_dsv_on(ctx);
+	jd35695b_reset(ctx);
+
+	ret = jd35695b_on(ctx);
+	if (ret < 0) {
+		dev_err(dev, "Failed to initialize panel: %d\n", ret);
+		jd35695b_dsv_off(ctx);
+		gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+		regulator_bulk_disable(ARRAY_SIZE(ctx->supplies), ctx->supplies);
+		return ret;
+	}
+
+	return 0;
+}
+
+static int jd35695b_unprepare(struct drm_panel *panel)
+{
+	struct jd35695b *ctx = to_jd35695b(panel);
+	struct device *dev = &ctx->dsi->dev;
+	int ret;
+
+	ret = jd35695b_off(ctx);
+	if (ret < 0)
+		dev_err(dev, "Failed to un-initialize panel: %d\n", ret);
+
+	/* mdss_dsi_panel_reset(0) with qcom,dsv-pre-off: DSV, then reset */
+	jd35695b_dsv_off(ctx);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	regulator_bulk_disable(ARRAY_SIZE(ctx->supplies), ctx->supplies);
+
+	return 0;
+}
+
+/* h: 1080 + 120 front + 4 sync + 76 back; v: 1920 + 8 + 1 + 7; 60 Hz */
+static const struct drm_display_mode jd35695b_mode = {
+	.clock = (1080 + 120 + 4 + 76) * (1920 + 8 + 1 + 7) * 60 / 1000,
+	.hdisplay = 1080,
+	.hsync_start = 1080 + 120,
+	.hsync_end = 1080 + 120 + 4,
+	.htotal = 1080 + 120 + 4 + 76,
+	.vdisplay = 1920,
+	.vsync_start = 1920 + 8,
+	.vsync_end = 1920 + 8 + 1,
+	.vtotal = 1920 + 8 + 1 + 7,
+	.width_mm = 65,
+	.height_mm = 115,
+	.type = DRM_MODE_TYPE_DRIVER,
+};
+
+static int jd35695b_get_modes(struct drm_panel *panel,
+			      struct drm_connector *connector)
+{
+	return drm_connector_helper_get_modes_fixed(connector, &jd35695b_mode);
+}
+
+static const struct drm_panel_funcs jd35695b_panel_funcs = {
+	.prepare = jd35695b_prepare,
+	.unprepare = jd35695b_unprepare,
+	.get_modes = jd35695b_get_modes,
+};
+
+/* the gamma table LK chose: its panel node name is on the command line */
+static void jd35695b_pick_gamma(struct jd35695b *ctx)
+{
+	const char *bootargs = NULL;
+	unsigned int i;
+
+	of_property_read_string(of_chosen, "bootargs", &bootargs);
+	for (i = 0; i < ARRAY_SIZE(jd35695b_gammas); i++)
+		if (bootargs && strstr(bootargs, jd35695b_gammas[i].cmdline))
+			break;
+	if (i == ARRAY_SIZE(jd35695b_gammas))
+		i = ARRAY_SIZE(jd35695b_gammas) - 1;
+	ctx->gamma = jd35695b_gammas[i].table;
+	ctx->gamma_len = jd35695b_gammas[i].len;
+	dev_info(&ctx->dsi->dev, "gamma: %s\n", jd35695b_gammas[i].cmdline);
+}
+
+static int jd35695b_probe(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	struct jd35695b *ctx;
+	int ret;
+
+	ctx = devm_kzalloc(dev, sizeof(*ctx), GFP_KERNEL);
+	if (!ctx)
+		return -ENOMEM;
+
+	ctx->supplies[0].supply = "tpvci";	/* L22, 3.1 V */
+	ctx->supplies[1].supply = "tpio";	/* L25, 1.8 V */
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(ctx->supplies), ctx->supplies);
+	if (ret < 0)
+		return dev_err_probe(dev, ret, "Failed to get regulators\n");
+
+	/* as-is: LK has the panel running and its splash on screen */
+	ctx->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_ASIS);
+	if (IS_ERR(ctx->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->reset_gpio),
+				     "Failed to get reset-gpios\n");
+	ctx->dsv_pos_gpio = devm_gpiod_get(dev, "dsv-pos", GPIOD_ASIS);
+	if (IS_ERR(ctx->dsv_pos_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->dsv_pos_gpio),
+				     "Failed to get dsv-pos-gpios\n");
+	ctx->dsv_neg_gpio = devm_gpiod_get(dev, "dsv-neg", GPIOD_ASIS);
+	if (IS_ERR(ctx->dsv_neg_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->dsv_neg_gpio),
+				     "Failed to get dsv-neg-gpios\n");
+	ret = gpiod_direction_output(ctx->reset_gpio, gpiod_get_value_cansleep(ctx->reset_gpio));
+	ret = ret ?: gpiod_direction_output(ctx->dsv_pos_gpio, gpiod_get_value_cansleep(ctx->dsv_pos_gpio));
+	ret = ret ?: gpiod_direction_output(ctx->dsv_neg_gpio, gpiod_get_value_cansleep(ctx->dsv_neg_gpio));
+	if (ret)
+		return dev_err_probe(dev, ret, "Failed to set up the GPIOs\n");
+	ctx->lk_on = !gpiod_get_value_cansleep(ctx->reset_gpio) &&
+		     gpiod_get_value_cansleep(ctx->dsv_pos_gpio);
+	dev_info(dev, "LK left the panel %s\n", ctx->lk_on ? "on" : "off");
+
+	ctx->dsi = dsi;
+	mipi_dsi_set_drvdata(dsi, ctx);
+	jd35695b_pick_gamma(ctx);
+
+	dsi->lanes = 4;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	/* command mode, no EoT packet, clock lane off between transfers */
+	dsi->mode_flags = MIPI_DSI_MODE_NO_EOT_PACKET |
+			  MIPI_DSI_CLOCK_NON_CONTINUOUS;
+
+	drm_panel_init(&ctx->panel, dev, &jd35695b_panel_funcs,
+		       DRM_MODE_CONNECTOR_DSI);
+	ctx->panel.prepare_prev_first = true;
+
+	ret = drm_panel_of_backlight(&ctx->panel);
+	if (ret)
+		return dev_err_probe(dev, ret, "Failed to get backlight\n");
+
+	drm_panel_add(&ctx->panel);
+
+	ret = mipi_dsi_attach(dsi);
+	if (ret < 0) {
+		dev_err_probe(dev, ret, "Failed to attach to DSI host\n");
+		drm_panel_remove(&ctx->panel);
+		return ret;
+	}
+
+	return 0;
+}
+
+static void jd35695b_remove(struct mipi_dsi_device *dsi)
+{
+	struct jd35695b *ctx = mipi_dsi_get_drvdata(dsi);
+	int ret;
+
+	ret = mipi_dsi_detach(dsi);
+	if (ret < 0)
+		dev_err(&dsi->dev, "Failed to detach from DSI host: %d\n", ret);
+
+	drm_panel_remove(&ctx->panel);
+}
+
+static const struct of_device_id jd35695b_of_match[] = {
+	{ .compatible = "lg,bullhead-jd35695b" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, jd35695b_of_match);
+
+static struct mipi_dsi_driver jd35695b_driver = {
+	.probe = jd35695b_probe,
+	.remove = jd35695b_remove,
+	.driver = {
+		.name = "panel-lg-bullhead-jd35695b",
+		.of_match_table = jd35695b_of_match,
+	},
+};
+module_mipi_dsi_driver(jd35695b_driver);
+
+MODULE_DESCRIPTION("DRM driver for the LG Nexus 5X JD35695B command-mode panel");
+MODULE_LICENSE("GPL");
