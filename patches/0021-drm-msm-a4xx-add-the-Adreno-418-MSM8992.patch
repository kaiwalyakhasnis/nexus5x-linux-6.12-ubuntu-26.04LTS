+
 static const unsigned int a405_registers[] = {
 	/* RBBM */
 	0x0000, 0x0002, 0x0004, 0x0021, 0x0023, 0x0024, 0x0026, 0x0026,
@@ -569,22 +625,80 @@ static void a4xx_dump(struct msm_gpu *gpu)
 	adreno_dump(gpu);
 }
 
+/*
+ * MSM8994/MSM8992: the GPU's SMMU (no mainline driver here) belongs to
+ * TrustZone. It loses its secure configuration whenever the GPU powers down,
+ * and without it the GPU's first memory access hangs the bus. TrustZone only
+ * restores it once its secure page table pool exists, which downstream sets
+ * up at boot (msm_iommu_sec_ptbl_init); do that here, once.
+ */
+static int a4xx_smmu_sec_init(struct device *dev)
+{
+	static bool done;
+	dma_addr_t paddr;
+	size_t psize = 0;
+	int ret;
+
+	if (done)
+		return 0;
+
+	if (!qcom_scm_is_available())
+		return -EPROBE_DEFER;
+
+	/* older TrustZones lack this one, downstream skips it there */
+	qcom_scm_iommu_set_cp_pool_size(0, 300 * SZ_1M);
+
+	ret = qcom_scm_iommu_secure_ptbl_size(0, &psize);
+	if (ret) {
+		DRM_DEV_ERROR(dev, "SMMU secure page table size: %d\n", ret);
+		return ret;
+	}
+
+	/* TrustZone's from now on, never freed */
+	if (!dma_alloc_attrs(dev, psize, &paddr, GFP_KERNEL,
+			     DMA_ATTR_NO_KERNEL_MAPPING))
+		return -ENOMEM;
+
+	ret = qcom_scm_iommu_secure_ptbl_init(paddr, psize, 0);
+	if (ret) {
+		DRM_DEV_ERROR(dev, "SMMU secure page table init: %d\n", ret);
+		return ret;
+	}
+
+	done = true;
+	return 0;
+}
+
 static int a4xx_pm_resume(struct msm_gpu *gpu) {
 	struct adreno_gpu *adreno_gpu = to_adreno_gpu(gpu);
+	struct a4xx_gpu *a4xx_gpu = to_a4xx_gpu(adreno_gpu);
 	int ret;
 
 	ret = msm_gpu_pm_resume(gpu);
 	if (ret)
 		return ret;
 
-	if (adreno_is_a430(adreno_gpu)) {
+	if (a4xx_gpu->smmu_sec_id) {
+		ret = qcom_scm_restore_sec_cfg(a4xx_gpu->smmu_sec_id, 0);
+		if (ret) {
+			DRM_DEV_ERROR(&gpu->pdev->dev,
+				      "SMMU secure config restore: %d\n", ret);
+			return ret;
+		}
+	}
+
+	if (adreno_is_a430(adreno_gpu) || adreno_is_a418(adreno_gpu)) {
 		unsigned int reg;
 		/* Set the default register values; set SW_COLLAPSE to 0 */
 		gpu_write(gpu, REG_A4XX_RBBM_POWER_CNTL_IP, 0x778000);
-		do {
-			udelay(5);
-			reg = gpu_read(gpu, REG_A4XX_RBBM_POWER_STATUS);
-		} while (!(reg & A4XX_RBBM_POWER_CNTL_IP_SP_TP_PWR_ON));
+		ret = gpu_poll_timeout(gpu, REG_A4XX_RBBM_POWER_STATUS, reg,
+				       reg & A4XX_RBBM_POWER_CNTL_IP_SP_TP_PWR_ON,
+				       5, 10000);
+		if (ret) {
+			DRM_DEV_ERROR(&gpu->pdev->dev,
+				      "SP/TP power on timed out: %08x\n", reg);
+			return ret;
+		}
 	}
 	return 0;
 }
@@ -597,7 +711,7 @@ static int a4xx_pm_suspend(struct msm_gpu *gpu) {
 	if (ret)
 		return ret;
 
-	if (adreno_is_a430(adreno_gpu)) {
+	if (adreno_is_a430(adreno_gpu) || adreno_is_a418(adreno_gpu)) {
 		/* Set the default register values; set SW_COLLAPSE to 1 */
 		gpu_write(gpu, REG_A4XX_RBBM_POWER_CNTL_IP, 0x778001);
 	}
@@ -677,6 +791,20 @@ struct msm_gpu *a4xx_gpu_init(struct drm_device *dev)
 	adreno_gpu = &a4xx_gpu->base;
 	gpu = &adreno_gpu->base;
 
+	/*
+	 * With more than one power domain (MSM8992: the VDD_GFX rail, then the
+	 * OXILI_GX GDSC on it) the driver core attaches none. Attach them all,
+	 * linked to the GPU's runtime PM, which then powers them up in DT order.
+	 */
+	if (!pdev->dev.pm_domain &&
+	    of_count_phandle_with_args(pdev->dev.of_node, "power-domains",
+				       "#power-domain-cells") > 1) {
+		ret = dev_pm_domain_attach_list(&pdev->dev, NULL,
+						&a4xx_gpu->pd_list);
+		if (ret < 0)
+			goto fail;
+	}
+
 	gpu->perfcntrs = NULL;
 	gpu->num_perfcntrs = 0;
 
@@ -684,11 +812,22 @@ struct msm_gpu *a4xx_gpu_init(struct drm_device *dev)
 	if (ret)
 		goto fail;
 
-	adreno_gpu->registers = adreno_is_a405(adreno_gpu) ? a405_registers :
-							     a4xx_registers;
+	if (!of_property_read_u32(pdev->dev.of_node, "qcom,iommu-secure-id",
+				  &a4xx_gpu->smmu_sec_id)) {
+		ret = a4xx_smmu_sec_init(&pdev->dev);
+		if (ret)
+			goto fail;
+	}
+
+	if (adreno_is_a405(adreno_gpu))
+		adreno_gpu->registers = a405_registers;
+	else if (adreno_is_a418(adreno_gpu))
+		adreno_gpu->registers = a418_registers;
+	else
+		adreno_gpu->registers = a4xx_registers;
 
 	/* if needed, allocate gmem: */
-	ret = adreno_gpu_ocmem_init(dev->dev, adreno_gpu,
+	ret = adreno_gpu_ocmem_init(&pdev->dev, adreno_gpu,
 				    &a4xx_gpu->ocmem);
 	if (ret)
 		goto fail;
diff --git a/drivers/gpu/drm/msm/adreno/a4xx_gpu.h b/drivers/gpu/drm/msm/adreno/a4xx_gpu.h
index a01448cba..6d9a991a0 100644
--- a/drivers/gpu/drm/msm/adreno/a4xx_gpu.h
+++ b/drivers/gpu/drm/msm/adreno/a4xx_gpu.h
@@ -17,6 +17,12 @@ struct a4xx_gpu {
 
 	/* if OCMEM is used for GMEM: */
 	struct adreno_ocmem ocmem;
+
+	/* more than one power domain (MSM8992: VDD_GFX, then OXILI_GX): */
+	struct dev_pm_domain_list *pd_list;
+
+	/* TrustZone's id for the GPU's SMMU (qcom,iommu-secure-id), or 0 */
+	u32 smmu_sec_id;
 };
 #define to_a4xx_gpu(x) container_of(x, struct a4xx_gpu, base)
 
diff --git a/drivers/gpu/drm/msm/adreno/adreno_gpu.h b/drivers/gpu/drm/msm/adreno/adreno_gpu.h
index 58d7e7915..0bc75fd55 100644
--- a/drivers/gpu/drm/msm/adreno/adreno_gpu.h
+++ b/drivers/gpu/drm/msm/adreno/adreno_gpu.h
@@ -350,6 +350,11 @@ static inline int adreno_is_a405(const struct adreno_gpu *gpu)
 	return adreno_is_revn(gpu, 405);
 }
 
+static inline int adreno_is_a418(const struct adreno_gpu *gpu)
+{
+	return adreno_is_revn(gpu, 418);
+}
+
 static inline int adreno_is_a420(const struct adreno_gpu *gpu)
 {
 	return adreno_is_revn(gpu, 420);
-- 
