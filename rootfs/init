#!/bin/sh
# Stage 1 – "early userspace". The kernel runs this as PID 1 straight out of
# the initramfs. Real distros do the same thing (initramfs-tools, dracut,
# Android's first-stage init): mount the API filesystems, then hand over.
/bin/busybox mount -t proc proc /proc   # --install needs /proc/self/exe
/bin/busybox --install -s
mount -t sysfs    sysfs    /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mkdir -p /dev/pts /sys/fs/pstore
mount -t devpts   devpts   /dev/pts
mount -t tmpfs    tmpfs    /run
mount -t tmpfs    tmpfs    /tmp
mount -t pstore   pstore   /sys/fs/pstore 2>/dev/null
mount -t configfs configfs /sys/kernel/config 2>/dev/null
echo "init: API filesystems mounted, handing over to busybox init"
# Stage 2 – replace ourselves (same PID 1) with a real init that reads /etc/inittab.
exec /sbin/init
